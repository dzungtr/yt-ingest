# LLM provider — OPENAI_API_KEY takes precedence when both are set.
OPENAI_API_KEY=your_key_here
# Optional: any OpenAI-compatible endpoint. Defaults to DeepSeek.
#OPENAI_BASE_URL=https://api.deepseek.com

# Anthropic-compatible fallback (used when OPENAI_API_KEY is absent).
#ANTHROPIC_API_KEY=your_key_here

# Optional model overrides (per provider defaults apply otherwise).
#YT_INGEST_MODEL=
#YT_INGEST_FAST_MODEL=
